+                // A popup enter is held until motion reaches it. A leave while
+                // that enter is pending has no matching event in Xwayland and
+                // must not disturb the previously entered parent surface.
+                if state.world.remove_one::<PendingEnter>(target).is_ok() {
+                    return;
+                }
+
+                // Ignore a stale leave rather than clearing a newer enter.
+                // Native compositors may replace pointer focus before a
