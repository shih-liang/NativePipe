diff --git a/src/server/tests.rs b/src/server/tests.rs
index deae742..b4858b8 100644
--- a/src/server/tests.rs
+++ b/src/server/tests.rs
@@ -3258,4 +3258,77 @@ fn decorations_with_title_on_thin_window() {

 /// See Pointer::handle_event for an explanation.
 #[test]
-fn popup_pointer_motion_workaround() {}
+fn popup_pointer_motion_workaround() {
+    let (mut f, comp) = TestFixture::new_with_compositor();
+    let pointer =
+        TestObject::<WlPointer>::from_request(&comp.seat.obj, wl_seat::Request::GetPointer {});
+
+    let toplevel = Window::new(1);
+    let (_, toplevel_id) = f.create_toplevel(&comp, toplevel);
+    let popup = Window::new(2);
+    let (_, popup_id) = f.create_popup(&comp, PopupBuilder::new(popup, toplevel, toplevel_id));
+
+    // This is the real sequence: the pointer was already on the parent when a
+    // popup appeared beneath it. Keep that parent as CurrentSurface while the
+    // popup enter is pending.
+    f.testwl.move_pointer_to(toplevel_id, 0.0, 0.0);
+    f.run();
+    f.run();
+    pointer.data.events.lock().unwrap().clear();
+
+    // The first popup enter is deliberately held until motion. If the popup
+    // leaves first, neither half may reach Xwayland.
+    f.testwl.move_pointer_to(popup_id, 1.0, 1.0);
+    f.run();
+    let popup_surface = f.testwl.get_surface_data(popup_id).unwrap().surface.clone();
+    f.testwl.pointer().leave(25, &popup_surface);
+    f.testwl.pointer().frame();
+    f.run();
+    f.run();
+    f.run();
+
+    let events = pointer.data.events.lock().unwrap();
+    assert!(
+        !events.iter().any(|event| matches!(
+            event,
+            Ev::<WlPointer>::Enter { .. } | Ev::<WlPointer>::Leave { .. }
+        )),
+        "popup leave was forwarded without a matching enter: {events:?}"
+    );
+    drop(events);
+
+    // The parent is still the active surface, so ordinary motion and both
+    // halves of the next click must continue to reach Xwayland.
+    f.testwl.pointer().motion(26, 2.0, 2.0);
+    f.testwl.pointer().button(
+        27,
+        27,
+        0x110,
+        s_proto::wl_pointer::ButtonState::Pressed,
+    );
+    f.testwl.pointer().button(
+        28,
+        28,
+        0x110,
+        s_proto::wl_pointer::ButtonState::Released,
+    );
+    f.testwl.pointer().frame();
+    f.run();
+    f.run();
+    f.run();
+    let events = pointer.data.events.lock().unwrap();
+    assert_eq!(
+        events
+            .iter()
+            .filter(|event| matches!(event, Ev::<WlPointer>::Motion { .. }))
+            .count(),
+        1
+    );
+    assert_eq!(
+        events
+            .iter()
+            .filter(|event| matches!(event, Ev::<WlPointer>::Button { .. }))
+            .count(),
+        2
+    );
+}
